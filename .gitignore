# Python
__pycache__/
*.py[cod]
*.egg-info/
*.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Node
node_modules/
frontend/dist/
*.log

# Outputs / runtime
outputs/
*.mp4
*.jpg
backend/*.dmp.zip
backend/*.dmp.zip.toml
backend/crash_*.txt
backend/ovrtx-studio-*.nv-gpudmp
backend_stdout.txt
backend_stderr.txt
